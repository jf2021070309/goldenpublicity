---
// PillarsAndQuote.astro (Metodología y Filosofía Golden Publicity)
const pillars = [
  {
    step: "01",
    title: "Top Of Mind",
    kicker: "Recordación de Marca",
    desc: "Posicionamos tu marca como la primera opción en la memoria y decisión inmediata del consumidor a través de estímulos visuales coordinados."
  },
  {
    step: "02",
    title: "Experiencia Sensorial",
    kicker: "Conexión en Vivo",
    desc: "Involucramos los sentidos del público mediante dinámicas directas, degustación, sampling y demostración interactiva de producto."
  },
  {
    step: "03",
    title: "Conexión Emocional",
    kicker: "Afinidad y Lealtad",
    desc: "Las emociones son el detonador decisivo en la compra. Creamos momentos memorables y de confianza que humanizan y engrandecen a tu empresa."
  },
  {
    step: "04",
    title: "Engagement & Conversión",
    kicker: "Retorno de Inversión",
    desc: "Traducimos la presencia de marca en prospectos calificados, aceleración de venta directa y lealtad a largo plazo en cada punto de contacto."
  }
];
---

<section class="pillars-section">
  <div class="container">
    <div class="pillars-header text-center reveal-scroll">
      <span class="section-kicker">Metodología & Filosofía</span>
      <h2 class="section-title">
        Estrategias que generan resultados<span class="dot">.</span>
      </h2>
      <p class="section-lead">
        En <strong>Golden Publicity</strong> fusionamos planeación publicitaria con ejecución impecable en campo. Cada acción está calculada para cautivar a tu público objetivo.
      </p>
    </div>

    <!-- Editorial 4-Step Methodology Showcase -->
    <div class="methodology-flow reveal-stagger">
      {pillars.map(p => (
        <div class="methodology-column">
          <div class="step-indicator-bar">
            <span class="step-num-badge">{p.step}</span>
            <div class="step-line"></div>
          </div>
          <div class="methodology-card">
            <span class="card-kicker">{p.kicker}</span>
            <h3 class="card-headline">{p.title}</h3>
            <p class="card-text">{p.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- High-Impact Quote Block -->
    <div class="golden-manifesto-box reveal-scale">
      <div class="manifesto-left-accent"></div>
      <div class="manifesto-inner">
        <blockquote class="manifesto-quote">
          "En <strong>Golden Publicity</strong> creemos firmemente en el poder del marketing en vivo y la experiencia directa. Nos apasiona la excelencia operativa y <em><strong>sabemos que lo diferente siempre será lo más recordado</strong></em>."
        </blockquote>
        <div class="manifesto-meta">
          <span class="manifesto-corp">Dirección General & Estrategia</span>
          <span class="manifesto-hq">San Pedro Garza García & Monterrey, N.L.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pillars-section {
    padding: 110px 0 100px;
    background: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .pillars-header {
    max-width: 860px;
    margin: 0 auto 65px;
  }

  /* Methodology Horizontal Flow */
  .methodology-flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin-bottom: 75px;
    position: relative;
  }

  .methodology-column {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .step-indicator-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .step-num-badge {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--color-orange);
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(255, 75, 0, 0.35);
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .methodology-column:hover .step-num-badge {
    background: var(--color-navy);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(6, 43, 92, 0.3);
    transform: scale(1.08);
  }

  .step-line {
    flex-grow: 1;
    height: 2px;
    background: linear-gradient(90deg, #ff4b00 0%, #cbd5e1 100%);
  }

  .methodology-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 32px 24px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(6, 43, 92, 0.05);
  }

  .methodology-card:hover {
    background: #ffffff;
    transform: translateY(-8px);
    box-shadow: 0 18px 40px rgba(6, 43, 92, 0.12);
    border-color: rgba(255, 75, 0, 0.45);
  }

  .card-kicker {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--color-orange);
    margin-bottom: 8px;
  }

  .card-headline {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-navy);
    margin-bottom: 14px;
    line-height: 1.25;
  }

  .card-text {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }

  /* Manifesto Quote Box */
  .golden-manifesto-box {
    display: flex;
    background: linear-gradient(135deg, #f8fafc 0%, #fff7ed 100%);
    border: 1px solid rgba(255, 75, 0, 0.2);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(6, 43, 92, 0.06);
    max-width: 1000px;
    margin: 0 auto;
  }

  .manifesto-left-accent {
    width: 8px;
    background: linear-gradient(180deg, var(--color-orange) 0%, var(--color-navy) 100%);
    flex-shrink: 0;
  }

  .manifesto-inner {
    padding: 45px 50px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .manifesto-quote {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--color-navy);
    line-height: 1.6;
    font-weight: 500;
    margin: 0;
  }

  .manifesto-quote strong {
    color: var(--color-navy);
    font-weight: 700;
  }

  .manifesto-quote em strong {
    color: var(--color-orange);
    font-style: italic;
  }

  .manifesto-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .manifesto-corp {
    font-size: 0.92rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-navy);
  }

  .manifesto-hq {
    font-size: 0.85rem;
    color: #64748b;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .methodology-flow {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 35px;
    }

    .manifesto-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }

  @media (max-width: 650px) {
    .methodology-flow {
      grid-template-columns: 1fr;
    }

    .manifesto-inner {
      padding: 30px 22px;
    }

    .manifesto-quote {
      font-size: 1.15rem;
    }
  }
</style>

---
// TestimonialsStrengths.astro (Diferenciales y Métricas Golden Publicity)
const metrics = [
  { count: "10", prefix: "+", suffix: "", label: "Años de Trayectoria", sub: "Liderando medios y activaciones" },
  { count: "500", prefix: "+", suffix: "", label: "Campañas BTL", sub: "Ejecutadas con éxito comprobado" },
  { count: "100", prefix: "+", suffix: "", label: "Grandes Marcas", sub: "Empresas líderes en todo el país" },
  { count: "100", prefix: "", suffix: "%", label: "Cobertura Nacional", sub: "Monterrey y toda la República" }
];

const pillars = [
  {
    num: "01",
    title: "Casting y Perfilamiento Riguroso",
    desc: "Evaluamos estatura, dicción, carisma, imagen profesional y experiencia. Seleccionamos el perfil exacto que armonice con los valores de tu marca.",
    highlight: "Personal 100% verificado y capacitado"
  },
  {
    num: "02",
    title: "Supervisión Directa en Sitio 24/7",
    desc: "Asignamos coordinadores de campo dedicados en cada punto de activación para monitorear asistencia, puntualidad, relevos y desempeño en vivo.",
    highlight: "Cero retrasos y coordinación inmediata"
  },
  {
    num: "03",
    title: "Estrategia BTL Integral 360°",
    desc: "No solo coordinamos talento: producimos uniformes bordados, stands, dinámicas con premios, botargas, sonido profesional y perifoneo móvil.",
    highlight: "Todo resuelto con un solo proveedor"
  },
  {
    num: "04",
    title: "Logística y Traslado Foráneo",
    desc: "Infraestructura probada para coordinar equipos de manera simultánea en Monterrey, San Pedro, CDMX, Guadalajara, Puebla y Cancún.",
    highlight: "Capacidad operativa multi-plaza"
  },
  {
    num: "05",
    title: "Entrega de Resultados & Evidencia HD",
    desc: "Tu inversión respaldada: al finalizar cada campaña entregamos un reporte cuantitativo de impactos y galería fotográfica profesional en alta definición.",
    highlight: "Reporte métrico y fotográfico garantizado"
  }
];
---

<section class="diferenciales-section">
  <div class="container">
    <!-- Animated Metrics Counter Bar -->
    <div class="metrics-glass-bar reveal-scroll">
      <div class="metrics-grid">
        {metrics.map(m => (
          <div class="metric-cell">
            <span 
              class="metric-val" 
              data-count={m.count} 
              data-prefix={m.prefix} 
              data-suffix={m.suffix}
            >
              {m.prefix}{m.count}{m.suffix}
            </span>
            <h4 class="metric-title">{m.label}</h4>
            <p class="metric-subtitle">{m.sub}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Section Heading -->
    <div class="diferenciales-header text-center reveal-scroll">
      <span class="section-kicker section-kicker-light">Estándar Operativo de Excelencia</span>
      <h2 class="section-title text-white">
        ¿Por qué elegirnos como tu aliado estratégico?<span class="dot">.</span>
      </h2>
      <p class="section-lead text-lead-light">
        Aportamos certidumbre, imagen y valor tangible a tu marca en cada evento, activación y congreso nacional.
      </p>
    </div>

    <!-- Split Showcase: Sticky Lead + Animated Timeline Matrix -->
    <div class="split-diferenciales-layout">
      <!-- Left Sticky Hero Box -->
      <div class="sticky-side-box reveal-left">
        <div class="sticky-inner-card">
          <div class="sticky-icon-glow">
            <i class="fa fa-shield"></i>
          </div>
          <h3 class="sticky-headline">
            El Sello Golden Publicity: Compromiso, Imagen y Resultados.
          </h3>
          <p class="sticky-paragraph">
            Cuidamos cada fase del proyecto desde el casting inicial hasta el desmontaje y la entrega de reportes. Trabajamos con los estándares más altos del mercado publicitario corporativo.
          </p>

          <div class="sticky-check-list">
            <div class="check-item">
              <i class="fa fa-check"></i> <span>Presencia y dicción impecable</span>
            </div>
            <div class="check-item">
              <i class="fa fa-check"></i> <span>Puntualidad rigurosa garantizada</span>
            </div>
            <div class="check-item">
              <i class="fa fa-check"></i> <span>Coordinadores con enlace directo</span>
            </div>
          </div>

          <div class="sticky-cta-wrap">
            <a href="#contacto" class="btn-golden-primary full-width">
              <i class="fa fa-paper-plane"></i> Cotizar Mi Campaña
            </a>
          </div>
        </div>
      </div>

      <!-- Right Feature Stream -->
      <div class="features-stream-side reveal-right">
        {pillars.map((item, idx) => (
          <div class="stream-item">
            <div class="stream-indicator">
              <span class="stream-number">{item.num}</span>
              {idx !== pillars.length - 1 && <div class="stream-line"></div>}
            </div>

            <div class="stream-card">
              <div class="stream-card-header">
                <h3 class="stream-title">{item.title}</h3>
                <span class="stream-pill-tag">
                  <i class="fa fa-star"></i> {item.highlight}
                </span>
              </div>
              <p class="stream-desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .diferenciales-section {
    padding: 110px 0 100px;
    background: linear-gradient(135deg, #03142c 0%, #062B5C 50%, #0a3d7d 100%);
    position: relative;
    overflow: hidden;
  }

  .diferenciales-section::before {
    content: '';
    position: absolute;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, rgba(255, 75, 0, 0.16) 0%, transparent 70%);
    top: -200px;
    left: -200px;
    pointer-events: none;
  }

  /* Animated Metrics Glass Bar */
  .metrics-glass-bar {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    padding: 38px 25px;
    margin-bottom: 75px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .metric-cell {
    text-align: center;
    position: relative;
  }

  .metric-cell:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 15%;
    height: 70%;
    width: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .metric-val {
    display: block;
    font-family: var(--font-heading);
    font-size: 3.4rem;
    font-weight: 800;
    color: var(--color-orange);
    line-height: 1;
    margin-bottom: 8px;
    text-shadow: 0 4px 18px rgba(255, 75, 0, 0.4);
  }

  .metric-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .metric-subtitle {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
  }

  /* Section Header */
  .diferenciales-header {
    max-width: 820px;
    margin: 0 auto 65px;
  }

  .text-white {
    color: #ffffff !important;
  }

  .text-lead-light {
    color: #cbd5e1 !important;
  }

  /* Split Layout */
  .split-diferenciales-layout {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 45px;
    align-items: start;
  }

  /* Left Sticky Card */
  .sticky-side-box {
    position: sticky;
    top: 110px;
  }

  .sticky-inner-card {
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 42px 36px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.2);
  }

  .sticky-icon-glow {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--color-orange), #ff7a3d);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    margin-bottom: 24px;
    box-shadow: 0 8px 24px rgba(255, 75, 0, 0.4);
  }

  .sticky-headline {
    font-size: 1.65rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .sticky-paragraph {
    font-size: 0.98rem;
    color: #cbd5e1;
    line-height: 1.65;
    margin-bottom: 26px;
  }

  .sticky-check-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }

  .check-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: #e2e8f0;
    font-weight: 600;
  }

  .check-item i {
    color: var(--color-orange);
    font-size: 1rem;
  }

  .btn-golden-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--color-orange);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 16px 32px;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(255, 75, 0, 0.35);
    transition: var(--transition-smooth);
  }

  .btn-golden-primary:hover {
    background: #ffffff;
    color: var(--color-navy);
    transform: translateY(-2px);
  }

  .full-width {
    width: 100%;
  }

  /* Right Features Stream */
  .features-stream-side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .stream-item {
    display: flex;
    gap: 22px;
  }

  .stream-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .stream-number {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-orange);
    background: rgba(255, 75, 0, 0.12);
    border: 1.5px solid rgba(255, 75, 0, 0.4);
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .stream-item:hover .stream-number {
    background: var(--color-orange);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(255, 75, 0, 0.45);
    transform: scale(1.08);
  }

  .stream-line {
    width: 2px;
    flex-grow: 1;
    background: linear-gradient(180deg, rgba(255, 75, 0, 0.4) 0%, rgba(255, 255, 255, 0.08) 100%);
    margin: 8px 0;
  }

  .stream-card {
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 26px 28px;
    flex-grow: 1;
    transition: all 0.35s ease;
  }

  .stream-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 75, 0, 0.4);
    transform: translateX(6px);
  }

  .stream-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 10px;
  }

  .stream-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
  }

  .stream-pill-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ff915e;
    background: rgba(255, 75, 0, 0.12);
    padding: 4px 10px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .stream-desc {
    font-size: 0.92rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 992px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 25px;
    }

    .metric-cell:nth-child(2)::after {
      display: none;
    }

    .split-diferenciales-layout {
      grid-template-columns: 1fr;
    }

    .sticky-side-box {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }

    .metric-cell::after {
      display: none !important;
    }

    .stream-card-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .stream-item {
      gap: 14px;
    }

    .sticky-inner-card {
      padding: 28px 20px;
    }
  }
</style>

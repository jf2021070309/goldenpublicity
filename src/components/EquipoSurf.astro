    display: inline-flex;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-navy);
    background: transparent;
    transition: var(--transition-smooth);
  }

  .filter-chip:hover {
    color: var(--color-orange);
    background: rgba(255, 75, 0, 0.06);
  }

  .filter-chip.active {
    background: var(--color-navy);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(6, 43, 92, 0.25);
  }

  /* Talent Grid */
  .talent-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin-bottom: 50px;
  }

  .talent-card {

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Golden Publicity | Líder en Medios Publicitarios, BTL y Modelos",
  description = "➤ Tel. 81 1683 7738 | Golden Publicity | Agencia líder en activaciones de marca BTL, edecanes AA/AAA, modelos, medios impresos y eventos en Monterrey y todo México.",
  image = "https://www.goldenpublicity.com.mx/wp-content/uploads/2026/08/WhatsApp-Image-2026-08-12-at-3.21.22-PM.jpeg"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://goldenpublicity.zelo.com.mx/" />

  <!-- Open Graph -->
  <meta property="og:locale" content="es_ES" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://goldenpublicity.zelo.com.mx/" />
  <meta property="og:site_name" content="Golden Publicity | Medios Publicitarios y BTL" />
  <meta property="og:image" content={image} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="https://www.goldenpublicity.com.mx/wp-content/uploads/2026/08/cropped-e1bc6a72-cc77-4821-a896-8e2ec0d5f9e4-1-32x32.jpg" sizes="32x32" />
  <link rel="apple-touch-icon" href="https://www.goldenpublicity.com.mx/wp-content/uploads/2026/08/cropped-e1bc6a72-cc77-4821-a896-8e2ec0d5f9e4-1-180x180.jpg" />

  <!-- FontAwesome & Icons CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
  <link rel="stylesheet" href="https://cdn.linearicons.com/free/1.0.0/icon-font.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/ionicons/2.0.1/css/ionicons.min.css" />
</head>
<body>
  <!-- Reading Progress Bar -->
  <div id="scroll-progress-bar" class="scroll-progress-bar"></div>

  <div class="site-wrapper">
    <slot />
  </div>

  <!-- Global Scroll Animation Script -->
  <script>
    // Scroll progress bar
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('scroll-progress-bar');
      if (bar) bar.style.width = scrolled + '%';
    });

    // IntersectionObserver for scroll animations
    const initScrollAnimations = () => {
      const observerOptions = {
        root: null,
        rootMargin: '0px 0px -40px 0px',
        threshold: 0.08
      };

      const animateCounter = (el: HTMLElement) => {
        const target = parseInt(el.getAttribute('data-count') || '0', 10);
        if (!target) return;
        const prefix = el.getAttribute('data-prefix') || '';
        const suffix = el.getAttribute('data-suffix') || '';
        let start = 0;
        const duration = 1600;
        const stepTime = 25;
        const steps = duration / stepTime;
        const increment = target / steps;
        const timer = setInterval(() => {
          start += increment;
          if (start >= target) {
            el.textContent = `${prefix}${target}${suffix}`;
            clearInterval(timer);
          } else {
            el.textContent = `${prefix}${Math.floor(start)}${suffix}`;
          }
        }, stepTime);
      };

      const scrollObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            
            // If it has counters inside
            const counters = entry.target.querySelectorAll<HTMLElement>('[data-count]');
            counters.forEach(c => animateCounter(c));
            if (entry.target.hasAttribute('data-count')) {
              animateCounter(entry.target as HTMLElement);
            }

            scrollObserver.unobserve(entry.target);
          }
        });
      }, observerOptions);

      // Target elements with animation classes
      const animatedElements = document.querySelectorAll(
        '.reveal-scroll, .reveal-scale, .reveal-left, .reveal-right, .reveal-stagger'
      );
      animatedElements.forEach(el => scrollObserver.observe(el));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrollAnimations);
    } else {
      initScrollAnimations();
    }
  </script>
</body>
</html>

<style>
  .scroll-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-orange), #ff7a3d, var(--color-navy));
    width: 0%;
    z-index: 99999;
    transition: width 0.1s ease-out;
    box-shadow: 0 0 10px rgba(255, 75, 0, 0.6);
  }

  .site-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
  }
</style>

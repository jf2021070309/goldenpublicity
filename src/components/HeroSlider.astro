---
// HeroSlider.astro
const slides = [
  {
    bg: "/images/eventos/evento-expo-stand-tokohama.jpg",
    badge: "AGENCIA LÍDER EN MÉXICO",
    title: "EXPERIENCIAS",
    subtitle: "LÍDER EN MEDIOS PUBLICITARIOS, BTL & MODELOS",
    gradient: "linear-gradient(90deg, #FF4B00 0%, #062B5C 100%)",
    position: "center 40%",
    alt: "Golden Publicity - Medios Publicitarios y Modelos",
    hasCta: true
  },
  {
    bg: "/images/activaciones/activacion-botargas-masiva.jpg",
    badge: "ACTIVACIONES BTL",
    title: "IMPACTANTES",
    subtitle: "HAY QUE DESTACAR DEL RESTO PARA SER RECORDADO",
    gradient: "linear-gradient(90deg, #FF4B00 0%, #062B5C 100%)",
    position: "center center",
    alt: "Activación Masiva BTL - Golden Publicity",
    hasCta: false
  },
  {
    bg: "/images/activaciones/activacion-distrito-padel-exterior.jpg",
    badge: "TALENTO & EDECANES",
    title: "ELEGANTES",
    subtitle: "TENEMOS EL TALENTO Y LA IMAGEN EXACTA PARA TU MARCA",
    gradient: "linear-gradient(90deg, #FF4B00 0%, #062B5C 100%)",
    position: "center 30%",
    alt: "Talento y Modelos BTL - Golden Publicity",
    hasCta: false
  },
  {
    bg: "/images/activaciones/activacion-camioneta-clasica-rotulada.jpg",
    badge: "CREATIVIDAD ESTRATÉGICA",
    title: "DIFERENTES",
    subtitle: "EXPERIENCIAS BTL DE ALTO IMPACTO EN TODO MÉXICO",
    gradient: "linear-gradient(90deg, #FF4B00 0%, #062B5C 100%)",
    position: "center 45%",
    alt: "Activaciones BTL y Vehículos Publicitarios",
    hasCta: false
  },
  {
    bg: "/images/activaciones/activacion-botargas-amarillas.jpg",
    badge: "PRESENCIA NACIONAL",
    title: "COBERTURA TOTAL",
    subtitle: "MONTERREY, CDMX, GUADALAJARA, PUEBLA Y CANCÚN",
    gradient: "linear-gradient(90deg, #FF4B00 0%, #062B5C 100%)",
    position: "center 35%",
    alt: "Cobertura Nacional BTL Golden Publicity",
    hasCta: false
  }
];
---

<section class="hero-slider" id="inicio">
  <div class="slides-container" id="slides-wrapper">
    {slides.map((slide, index) => (
      <div class={`slide ${index === 0 ? 'active' : ''}`} data-index={index}>
        <div 
          class="slide-bg" 
          style={`background-image: url('${slide.bg}'); background-position: ${slide.position || 'center center'};`}
        ></div>
        <div class="slide-overlay"></div>
        <div class="slide-content">
          <div class="headline-slide">
            {slide.badge && (
              <span class="hero-badge">{slide.badge}</span>
            )}
            <h1 class="hero-title">
              {slide.title}<span class="hero-dot">.</span>
            </h1>
            <div class="hero-line" style={`background: ${slide.gradient}`}></div>
            <p class="hero-subtitle">{slide.subtitle}</p>
            {slide.hasCta && (
              <div class="hero-actions">
                <a href="#contacto" class="btn-hero-primary">Cotizar Campaña</a>
                <a href="#experiencias" class="btn-hero-secondary">Ver Activaciones</a>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Navigation Arrows -->
  <button class="slider-arrow prev" id="slider-prev" aria-label="Slide anterior">
    <i class="fa fa-angle-left"></i>
  </button>
  <button class="slider-arrow next" id="slider-next" aria-label="Siguiente slide">
    <i class="fa fa-angle-right"></i>
  </button>

  <!-- Dots Navigation -->
  <div class="slider-dots" id="slider-dots">
    {slides.map((_, index) => (
      <button 
        class={`dot ${index === 0 ? 'active' : ''}`} 
        data-slide-to={index} 
        aria-label={`Ir al slide ${index + 1}`}
      ></button>
    ))}
  </div>
</section>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll<HTMLElement>('.hero-slider .slide');
  const dots = document.querySelectorAll<HTMLElement>('.hero-slider .dot');
  const totalSlides = slides.length;
  let autoPlayTimer: any;

  function showSlide(index: number) {
    slides.forEach((slide, i) => {
      slide.classList.toggle('active', i === index);
    });
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
    });
    currentSlide = index;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % totalSlides);
  }

  function prevSlide() {
    showSlide((currentSlide - 1 + totalSlides) % totalSlides);
  }

  function startAutoPlay() {
    stopAutoPlay();
    autoPlayTimer = setInterval(nextSlide, 5000);
  }

  function stopAutoPlay() {
    if (autoPlayTimer) clearInterval(autoPlayTimer);
  }

  document.getElementById('slider-next')?.addEventListener('click', () => {
    nextSlide();
    startAutoPlay();
  });

  document.getElementById('slider-prev')?.addEventListener('click', () => {
    prevSlide();
    startAutoPlay();
  });

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      showSlide(index);
      startAutoPlay();
    });
  });

  const heroSlider = document.querySelector('.hero-slider');
  heroSlider?.addEventListener('mouseenter', stopAutoPlay);
  heroSlider?.addEventListener('mouseleave', startAutoPlay);

  startAutoPlay();
</script>

<style>
  .hero-slider {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    max-height: 1080px;
    overflow: hidden;
    background-color: #0c0c0c;
  }

  .slides-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.9s ease;
  }

  .slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-repeat: no-repeat;
    transform: scale(1.02);
    transition: transform 6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .slide.active .slide-bg {
    transform: scale(1);
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(6, 43, 92, 0.4) 0%, rgba(3, 10, 22, 0.78) 100%);
  }

  .slide-content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 24px;
  }

  /* Headline Slide */
  .headline-slide {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 1100px;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(255, 75, 0, 0.14);
    border: 1px solid rgba(255, 75, 0, 0.35);
    padding: 6px 18px;
    border-radius: 30px;
    margin-bottom: 20px;
    backdrop-filter: blur(8px);
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-top: 32px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-hero-primary {
    background-color: var(--color-orange);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 14px 32px;
    border-radius: 4px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 24px rgba(255, 75, 0, 0.4);
  }

  .btn-hero-primary:hover {
    background-color: #e04100;
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(255, 75, 0, 0.55);
  }

  .btn-hero-secondary {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(6px);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 14px 30px;
    border-radius: 4px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
    border-color: #ffffff;
    transform: translateY(-3px);
  }

  .hero-title {
    font-size: clamp(2.8rem, 8vw, 7.5rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -1px;
    text-transform: uppercase;
    line-height: 0.95;
    text-shadow: 0 8px 30px rgba(0,0,0,0.7);
    margin-bottom: 20px;
  }

  .hero-dot {
    color: var(--color-accent);
  }

  .hero-line {
    width: clamp(260px, 60vw, 750px);
    height: 4px;
    border-radius: 4px;
    margin-bottom: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }

  .hero-subtitle {
    font-family: var(--font-slogan);
    font-size: clamp(1rem, 2.2vw, 1.6rem);
    letter-spacing: 5px;
    color: #ffffff;
    font-weight: 400;
    text-transform: uppercase;
    text-shadow: 0 4px 15px rgba(0,0,0,0.8);
  }

  /* Arrows */
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(0,0,0,0.35);
    color: #ffffff;
    font-size: 1.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all 0.25s ease;
    border: 1px solid rgba(255,255,255,0.15);
  }

  .slider-arrow:hover {
    background: var(--color-accent);
    color: #111111;
    border-color: var(--color-accent);
  }

  .slider-arrow.prev {
    left: 28px;
  }

  .slider-arrow.next {
    right: 28px;
  }

  /* Dots */
  .slider-dots {
    position: absolute;
    bottom: 35px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 10;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    transition: all 0.3s ease;
  }

  .dot.active, .dot:hover {
    background: var(--color-accent);
    transform: scale(1.25);
  }

  @media (max-width: 768px) {
    .slider-arrow {
      display: none;
    }
    .hero-line {
      height: 3px;
      margin-bottom: 16px;
    }
    .hero-subtitle {
      letter-spacing: 2px;
    }
  }
</style>

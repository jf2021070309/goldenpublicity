    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 15px 32px;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(255, 75, 0, 0.35);
    transition: var(--transition-smooth);
  }

  .btn-golden-primary:hover {
    background: var(--color-navy);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(6, 43, 92, 0.3);
    color: #ffffff;
  }

  .btn-golden-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #25D366;

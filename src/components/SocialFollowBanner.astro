---
// SocialFollowBanner.astro (Redes Sociales Golden Publicity)
---

<section class="social-follow-section">
  <div class="container">
    <div class="social-banner-box glass-card reveal-left">
      <span class="section-kicker">Comunidad & Actualizaciones</span>
      <h2 class="social-banner-title">
        Conéctate con Golden Publicity<span class="dot">.</span>
      </h2>
      <p class="social-banner-sub">
        Sigue de cerca el detrás de cámaras de nuestras <a href="https://www.instagram.com/goldenpublicity23" target="_blank" rel="noopener">activaciones en vivo</a>, coberturas en televisión, desfiles de moda y eventos corporativos en todo México.
      </p>

      <div class="social-buttons-row">
        <a 
          href="https://www.instagram.com/goldenpublicity23" 
          target="_blank" 
          rel="noopener" 
          class="btn-social-gold instagram"
        >
          <i class="fa fa-instagram"></i> @goldenpublicity23
        </a>
        <a 
          href="https://www.facebook.com/profile.php?id=100090488202295&mibextid=ZbWKwL" 
          target="_blank" 
          rel="noopener" 
          class="btn-social-gold facebook"
        >
          <i class="fa fa-facebook"></i> Facebook Oficial
        </a>
        <a 
          href="https://wa.me/5218116837738?text=Hola%20Golden%20Publicity,%20quiero%20conocer%20m%C3%A1s%20de%20sus%20servicios" 
          target="_blank" 
          rel="noopener" 
          class="btn-social-gold whatsapp"
        >
          <i class="fa fa-whatsapp"></i> 81 1683 7738
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .social-follow-section {
    position: relative;
    padding: 130px 0;
    background-image: url('/images/eventos/evento-concierto-festival-masivo.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    display: flex;
    align-items: center;
  }

  .social-follow-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 43, 92, 0.88) 0%, rgba(6, 43, 92, 0.65) 60%, rgba(255, 75, 0, 0.3) 100%);
  }

  .social-banner-box {
    position: relative;
    z-index: 2;
    max-width: 620px;
    padding: 45px 40px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }



  .social-banner-title {
    font-size: 2.6rem;
    color: var(--color-navy);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .social-banner-title .dot {
    color: var(--color-orange);
  }

  .social-banner-sub {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 30px;
  }

  .social-banner-sub a {
    color: var(--color-orange);
    text-decoration: underline;
    font-weight: 600;
  }

  .social-buttons-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn-social-gold {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-navy);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 999px;
    transition: var(--transition-smooth);
    box-shadow: 0 4px 14px rgba(6, 43, 92, 0.2);
  }

  .btn-social-gold.instagram:hover {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(220, 39, 67, 0.35);
  }

  .btn-social-gold.facebook:hover {
    background: #1877F2;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(24, 119, 242, 0.35);
  }

  .btn-social-gold.whatsapp:hover {
    background: #25D366;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(37, 211, 102, 0.35);
  }

  @media (max-width: 768px) {
    .social-follow-section {
      padding: 80px 0;
      background-attachment: scroll;
    }
    .social-banner-box {
      padding: 30px 20px;
    }
    .social-banner-title {
      font-size: 2rem;
    }
    .btn-social-gold {
      width: 100%;
      justify-content: center;
    }
  }
</style>

server {
    listen 80;
    listen [::]:80;
    server_name goldenpublicity.zelo.com.mx;

    # Directorio donde se ubican los archivos compilados de Astro (dist)
    root /var/www/goldenpublicity/dist;
    index index.html;

    # Logs
    access_log /var/log/nginx/goldenpublicity.access.log;
    error_log /var/log/nginx/goldenpublicity.error.log;

    # Compresión Gzip para máxima velocidad
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache agresivo para assets estáticos (_astro, fuentes, imágenes)
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Seguridad adicional
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
}

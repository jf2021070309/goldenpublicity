---
// KineticTicker.astro (Faulhaber Kinetic Typography Marquee & Zorro Rotating Agency Badge)
---

<div class="kinetic-ticker-section">
  <!-- Track 1: Moving Left on scroll -->
  <div class="kinetic-line-wrap">
    <div class="kinetic-track kinetic-track-left">
      <span class="kinetic-item filled">GOLDEN PUBLICITY</span>
      <span class="kinetic-star">✦</span>
      <span class="kinetic-item outline">ACTIVACIONES BTL</span>
      <span class="kinetic-star">✦</span>
      <span class="kinetic-item filled">EDECANES AAA</span>
      <span class="kinetic-star">✦</span>
      <span class="kinetic-item outline">PASARELA & MODA</span>
      <span class="kinetic-star">✦</span>
      <span class="kinetic-item filled">EXPOS CINTERMEX</span>
      <span class="kinetic-star">✦</span>
      <span class="kinetic-item outline">MEDIOS IMPRESOS</span>
      <span class="kinetic-star">✦</span>
      <!-- Duplicate for seamless infinite flow -->
      <span class="kinetic-item filled">GOLDEN PUBLICITY</span>
      <span class="kinetic-star">✦</span>
      <span class="kinetic-item outline">ACTIVACIONES BTL</span>
      <span class="kinetic-star">✦</span>
      <span class="kinetic-item filled">EDECANES AAA</span>
      <span class="kinetic-star">✦</span>
      <span class="kinetic-item outline">PASARELA & MODA</span>
      <span class="kinetic-star">✦</span>
    </div>
  </div>

  <!-- Track 2: Moving Right on scroll -->
  <div class="kinetic-line-wrap">
    <div class="kinetic-track kinetic-track-right">
      <span class="kinetic-item outline">MONTERREY</span>
      <span class="kinetic-star">★</span>
      <span class="kinetic-item filled">SAN PEDRO GARZA GARCÍA</span>
      <span class="kinetic-star">★</span>
      <span class="kinetic-item outline">CIUDAD DE MÉXICO</span>
      <span class="kinetic-star">★</span>
      <span class="kinetic-item filled">GUADALAJARA</span>
      <span class="kinetic-star">★</span>
      <span class="kinetic-item outline">PUEBLA</span>
      <span class="kinetic-star">★</span>
      <span class="kinetic-item filled">CANCÚN & RIVIERA MAYA</span>
      <span class="kinetic-star">★</span>
      <span class="kinetic-item outline">COBERTURA NACIONAL</span>
      <span class="kinetic-star">★</span>
      <!-- Duplicate -->
      <span class="kinetic-item outline">MONTERREY</span>
      <span class="kinetic-star">★</span>
      <span class="kinetic-item filled">SAN PEDRO GARZA GARCÍA</span>
      <span class="kinetic-star">★</span>
      <span class="kinetic-item outline">CIUDAD DE MÉXICO</span>
      <span class="kinetic-star">★</span>
    </div>
  </div>
  <!-- Center Medallion: Rotating Agency Stamp (Zorro / Godly / Awwwards) -->
  <div class="ticker-stamp-wrapper" aria-hidden="true">
    <div class="spinning-agency-stamp">
      <svg viewBox="0 0 200 200" class="stamp-svg">
        <defs>
          <path 
            id="circlePath" 
            d="M 100, 100 m -75, 0 a 75,75 0 1,1 150,0 a 75,75 0 1,1 -150,0" 
          />
        </defs>
        <!-- Circular Text -->
        <text class="stamp-text">
          <textPath href="#circlePath" startOffset="0%">
            ★ GOLDEN PUBLICITY ★ MEDIOS BTL & MODELOS ★ MÉXICO ★
          </textPath>
        </text>
      </svg>
      <div class="stamp-center">
        <span class="stamp-monogram">GP</span>
      </div>
    </div>
  </div>
</div>

<style>
  .kinetic-ticker-section {
    padding: 70px 0 60px;
    background: #062B5C;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(255, 75, 0, 0.2);
    border-bottom: 1px solid rgba(255, 75, 0, 0.2);
  }

  .kinetic-line-wrap {
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    user-select: none;
    margin: 8px 0;
  }

  .kinetic-track {
    display: inline-flex;
    align-items: center;
    gap: 32px;
    will-change: transform;
    font-family: var(--font-heading);
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 2px;
    line-height: 1.1;
  }

  .kinetic-item.filled {
    color: #ffffff;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .kinetic-item.outline {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.45);
    transition: -webkit-text-stroke 0.3s ease;
  }

  .kinetic-item.outline:hover {
    -webkit-text-stroke: 1.5px var(--color-orange);
  }

  .kinetic-star {
    color: var(--color-orange);
    font-size: 0.6em;
    filter: drop-shadow(0 0 10px rgba(255, 75, 0, 0.6));
  }

  /* Center Medallion Stamp (Awwwards / Godly / Zorro) */
  .ticker-stamp-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spinning-agency-stamp {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: rgba(6, 43, 92, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 75, 0, 0.35);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: rotateForever 20s linear infinite;
    transform-origin: center center;
    pointer-events: auto;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .spinning-agency-stamp:hover {
    transform: scale(1.1);
    border-color: var(--color-orange);
    box-shadow: 0 14px 40px rgba(255, 75, 0, 0.4);
  }

  @keyframes rotateForever {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .stamp-svg {
    width: 100%;
    height: 100%;
  }

  .stamp-text {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 2.2px;
    fill: #ffffff;
    text-transform: uppercase;
  }

  .stamp-center {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-orange);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(255, 75, 0, 0.4);
  }

  .stamp-monogram {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: 1px;
  }

  @media (max-width: 768px) {
    .ticker-stamp-wrapper {
      display: none;
    }

    .kinetic-ticker-section {
      padding: 45px 0 40px;
    }
  }
</style>

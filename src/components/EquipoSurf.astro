---

<section class="equipo-golden-section" id="equipo-surf">
  <div class="container">
    <!-- Header -->
    <div class="equipo-header-area reveal-scroll">
      <span class="section-kicker">Talento Profesional & Presencia de Marca</span>
      <span class="section-subtitle">GRANDES MARCAS, GRAN EQUIPO</span>
      <h2 class="section-title">
        Equipo Golden Publicity<span class="dot">.</span>
      </h2>
      <p class="section-lead">
        Consolidados como una agencia de referencia en <strong>Medios Publicitarios, BTL, Edecanes y Modelos</strong> en Monterrey, San Pedro Garza García y con cobertura en toda la República Mexicana. Ponemos a tu disposición un talentoso y calificado equipo para representar a tu marca con <strong>máximo impacto, profesionalismo y distinción</strong> en expos, eventos masivos y campañas BTL.
      </p>

      <div class="header-actions">
        <a href="#contacto" class="btn-golden-primary">
          <i class="fa fa-book"></i> Solicitar Book de Talentos
        </a>
        <a href="https://wa.me/5218116837738?text=Hola%20Golden%20Publicity,%20me%20gustar%C3%ADa%20solicitar%20el%20book%20de%20talentos%20y%20edecanes" target="_blank" rel="noopener" class="btn-golden-whatsapp">
          <i class="fa fa-whatsapp"></i> Cotizar por WhatsApp
        </a>
      </div>

      <!-- Modern Filter Pills -->
      <div class="talent-filter-bar">
        <button class="filter-chip active" data-filter="all">
          <i class="fa fa-th-large"></i> Todos los Perfiles
        </button>
        <button class="filter-chip" data-filter="edecanes">
          <i class="fa fa-check-circle"></i> Edecanes AA y AAA
        </button>
        <button class="filter-chip" data-filter="modelos">
          <i class="fa fa-camera"></i> Modelos & Pasarela
        </button>
        <button class="filter-chip" data-filter="btl">
          <i class="fa fa-bullhorn"></i> Activaciones BTL
        </button>
        <button class="filter-chip" data-filter="hostess">
          <i class="fa fa-user"></i> Gios & Hostess VIP
        </button>
      </div>
    </div>

    <!-- Modern Talent Grid -->
    <div class="talent-grid reveal-stagger" id="models-container">
      {models.map(model => (
        <div 
          class="talent-card" 
          data-category={model.category}
          data-name={model.name}
          data-role={model.role}
          data-city={model.city}
          data-stats={model.stats}
          data-desc={model.desc}
          data-img={model.image}
        >
          <div class="card-image-box">
            <img 
              src={model.image} 
              alt={`${model.name} - Golden Publicity`} 
              loading="lazy" 
            />
            <div class="card-status-pill">
              <span class="status-indicator"></span> Disponible
            </div>
            <div class="card-category-badge">
              {model.tag}
            </div>
            
            <div class="card-hover-overlay">
              <button class="btn-view-profile" aria-label="Ver detalles">
                <i class="fa fa-search-plus"></i> Ver Perfil Completo
              </button>
            </div>
          </div>

          <div class="card-details-box">
            <div class="card-meta">
              <span class="city-location">
                <i class="fa fa-map-marker"></i> {model.city}
              </span>
            </div>
            <h3 class="talent-title">{model.name}</h3>
            <p class="talent-role">{model.role}</p>
            <p class="talent-short-desc">{model.desc}</p>
            
            <div class="card-footer-action">
              <span class="talent-specs">{model.stats}</span>
              <a 
                href={`https://wa.me/5218116837738?text=Hola%20Golden%20Publicity,%20deseo%20cotizar%20el%20perfil%20de%20${encodeURIComponent(model.name)}`}
                target="_blank" 
                rel="noopener"
                class="direct-quote-link"
                title="Cotizar este perfil"
              >
                <i class="fa fa-whatsapp"></i> Cotizar
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Notice -->
    <div class="talent-footer-note reveal-scroll">
      <p>
        <i class="fa fa-shield"></i> Todo nuestro talento cuenta con riguroso proceso de casting, puntualidad garantizada, imagen profesional y supervisión directa de coordinadores en campo.
      </p>
    </div>
  </div>

  <!-- Interactive Lightbox Modal -->
  <div id="talent-modal" class="talent-modal" aria-hidden="true">
    <div class="modal-backdrop" id="modal-backdrop"></div>
    <div class="modal-window">
      <button class="modal-close-btn" id="modal-close" aria-label="Cerrar modal">&times;</button>
      <div class="modal-content-grid">
        <div class="modal-image-col">
          <img id="modal-img" src="" alt="Talento Golden Publicity" />
        </div>
        <div class="modal-info-col">
          <span class="modal-badge" id="modal-category">Edecanes AAA</span>
          <h3 class="modal-title" id="modal-name">Nombre</h3>
          <p class="modal-role" id="modal-role">Especialidad</p>
          <div class="modal-divider"></div>
          
          <div class="modal-meta-row">
            <span class="modal-meta-item">
              <i class="fa fa-map-marker"></i> <strong id="modal-city">Ciudad</strong>
            </span>
            <span class="modal-meta-item">
              <i class="fa fa-check-circle"></i> <span id="modal-stats">Specs</span>
            </span>
          </div>

          <p class="modal-desc" id="modal-desc">Descripción del talento</p>

          <div class="modal-cta-group">
            <a id="modal-wa-btn" href="#" target="_blank" rel="noopener" class="btn-golden-primary full-width">
              <i class="fa fa-whatsapp"></i> Cotizar Este Perfil por WhatsApp
            </a>
            <a href="#contacto" class="btn-golden-secondary full-width" id="modal-contact-link">
              <i class="fa fa-envelope-o"></i> Solicitar Book Completo
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Filter Functionality
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const talentCards = document.querySelectorAll<HTMLElement>('.talent-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filterValue = btn.getAttribute('data-filter');

      talentCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filterValue === 'all' || category === filterValue) {
          card.style.display = 'flex';
          setTimeout(() => {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0) scale(1)';
          }, 30);
        } else {
          card.style.opacity = '0';
          card.style.transform = 'translateY(15px) scale(0.97)';
          setTimeout(() => {
            card.style.display = 'none';
          }, 250);
        }
      });
    });
  });

  // Lightbox Modal
  const modal = document.getElementById('talent-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('modal-close');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalName = document.getElementById('modal-name');
  const modalRole = document.getElementById('modal-role');
  const modalCity = document.getElementById('modal-city');
  const modalStats = document.getElementById('modal-stats');
  const modalDesc = document.getElementById('modal-desc');
  const modalCat = document.getElementById('modal-category');
  const modalWaBtn = document.getElementById('modal-wa-btn') as HTMLAnchorElement;
  const modalContactLink = document.getElementById('modal-contact-link');

  const openModal = (card: HTMLElement) => {
    const name = card.getAttribute('data-name') || '';
    const role = card.getAttribute('data-role') || '';
    const city = card.getAttribute('data-city') || '';
    const stats = card.getAttribute('data-stats') || '';
    const desc = card.getAttribute('data-desc') || '';
    const category = card.getAttribute('data-category') || '';
    const img = card.getAttribute('data-img') || '';

    if (modalImg) modalImg.src = img;
    if (modalName) modalName.textContent = name;
    if (modalRole) modalRole.textContent = role;
    if (modalCity) modalCity.textContent = city;
    if (modalStats) modalStats.textContent = stats;
    if (modalDesc) modalDesc.textContent = desc;
    if (modalCat) modalCat.textContent = category.toUpperCase();

    if (modalWaBtn) {
      modalWaBtn.href = `https://wa.me/5218116837738?text=Hola%20Golden%20Publicity,%20me%20interesa%20cotizar%20el%20perfil%20de%20${encodeURIComponent(name)}%20para%20un%20evento`;
    }

    if (modal) {
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
  };

  const closeModal = () => {
    if (modal) {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  };

  talentCards.forEach(card => {
    card.addEventListener('click', () => openModal(card));
  });

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  modalContactLink?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

<style>
  .equipo-golden-section {
    padding: 110px 0 90px;
    background: linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%);

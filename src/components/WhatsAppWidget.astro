---
// WhatsAppWidget.astro
---

<div class="whatsapp-floating-widget" id="whatsapp-widget">
  <!-- Tooltip Bubble -->
  <div class="wa-tooltip" id="wa-tooltip">
    <div class="wa-tooltip-header">
      <span class="wa-status-dot"></span>
      <strong>Golden Publicity</strong>
      <button class="wa-close-btn" id="wa-close-btn">&times;</button>
    </div>
    <div class="wa-tooltip-body">
      Hola 👋<br />¿En qué podemos apoyarte?
    </div>
    <a 
      href="https://wa.me/5212212529626?text=Hola%2C%20quisiera%20cotizar%20edecanes%20y%20modelos%20para%20un%20evento" 
      target="_blank" 
      rel="noopener" 
      class="wa-chat-action"
    >
      <i class="fa fa-whatsapp"></i> Abrir chat
    </a>
  </div>

  <!-- Trigger Button -->
  <button class="wa-trigger-btn" id="wa-trigger-btn" aria-label="Abrir chat de WhatsApp">
    <i class="fa fa-whatsapp"></i>
    <span class="wa-badge">1</span>
  </button>
</div>

<script>
  const waWidget = document.getElementById('whatsapp-widget');
  const waTooltip = document.getElementById('wa-tooltip');
  const waTrigger = document.getElementById('wa-trigger-btn');
  const waClose = document.getElementById('wa-close-btn');

  // Show tooltip after 2.5 seconds
  setTimeout(() => {
    waTooltip?.classList.add('visible');
  }, 2500);

  waTrigger?.addEventListener('click', () => {
    waTooltip?.classList.toggle('visible');
  });

  waClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    waTooltip?.classList.remove('visible');
  });
</script>

<style>
  .whatsapp-floating-widget {
    position: fixed;
    bottom: 28px;
    left: 28px;
    z-index: 999;
  }

  .wa-trigger-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #25d366;
    color: #ffffff;
    font-size: 2.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    position: relative;
  }

  .wa-trigger-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.6);
  }

  .wa-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    background: #ff3b30;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
  }

  /* Tooltip Box */
  .wa-tooltip {
    position: absolute;
    bottom: 74px;
    left: 0;
    width: 270px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 12px 36px rgba(0,0,0,0.22);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .wa-tooltip.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .wa-tooltip-header {
    background: #075e54;
    color: #ffffff;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
  }

  .wa-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #25d366;
  }

  .wa-close-btn {
    margin-left: auto;
    color: #ffffff;
    font-size: 1.2rem;
    line-height: 1;
    opacity: 0.8;
  }

  .wa-close-btn:hover {
    opacity: 1;
  }

  .wa-tooltip-body {
    padding: 14px;
    font-size: 0.92rem;
    color: #333333;
    line-height: 1.5;
    background: #e5ddd5;
    background-image: radial-gradient(rgba(0,0,0,0.06) 1px, transparent 0);
    background-size: 10px 10px;
  }

  .wa-chat-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #25d366;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 12px 16px;
    text-align: center;
    transition: background 0.2s;
  }

  .wa-chat-action:hover {
    background: #20ba59;
  }

  @media (max-width: 600px) {
    .whatsapp-floating-widget {
      bottom: 20px;
      left: 20px;
    }
  }
</style>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Golden Publicity | Líder en Medios Publicitarios, BTL y Modelos",
  description = "➤ Tel. 81 1683 7738 | Golden Publicity | Agencia líder en activaciones de marca BTL, edecanes AA/AAA, modelos, medios impresos y eventos en Monterrey y todo México.",
  image = "/images/branding/logo-trans.png"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://goldenpublicity.zelo.com.mx/" />

  <!-- Open Graph -->
  <meta property="og:locale" content="es_ES" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://goldenpublicity.zelo.com.mx/" />
  <meta property="og:site_name" content="Golden Publicity | Medios Publicitarios y BTL" />
  <meta property="og:image" content={image} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/branding/logo-icon.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/images/branding/logo-icon.png" />
  <link rel="apple-touch-icon" href="/images/branding/logo-icon.png" />

  <!-- FontAwesome & Icons CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
  <link rel="stylesheet" href="https://cdn.linearicons.com/free/1.0.0/icon-font.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/ionicons/2.0.1/css/ionicons.min.css" />
</head>
<body>
  <!-- Custom Interactive Magnetic Cursor (The3Key / Godly / Awwwards) -->
  <div id="cursor-dot" class="custom-cursor-dot" aria-hidden="true"></div>
  <div id="cursor-follower" class="custom-cursor-follower" aria-hidden="true">
    <span id="cursor-text" class="cursor-text"></span>
  </div>

  <!-- Reading Progress Bar -->
  <div id="scroll-progress-bar" class="scroll-progress-bar"></div>

  <div class="site-wrapper">
    <slot />
  </div>

  <!-- Awwwards Motion Engine (Lenis, GSAP, 3D Tilt, Magnetic Physics) -->
  <script>
    import { initAwwwardsMotion } from '../scripts/motion';
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAwwwardsMotion());
    } else {
      initAwwwardsMotion();
    }
  </script>
</body>
</html>

<style is:global>
  /* Lenis Smooth Scroll System */
  html.lenis, html.lenis-smooth {
    height: auto;
    scroll-behavior: auto !important;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-scrolling iframe {
    pointer-events: none;
  }

  /* Custom Interactive Magnetic Cursor (The3Key / Godly) */
  .custom-cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 8px;
    height: 8px;
    background-color: var(--color-orange);
    border-radius: 50%;
    pointer-events: none;
    z-index: 999999;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease, transform 0.05s ease;
  }

  .custom-cursor-follower {
    position: fixed;
    top: 0;
    left: 0;
    width: 42px;
    height: 42px;
    border: 1.5px solid rgba(255, 75, 0, 0.6);
    border-radius: 50%;
    pointer-events: none;
    z-index: 999998;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                height 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                background-color 0.3s ease, 
                border-color 0.3s ease, 
                box-shadow 0.3s ease;
  }

  .cursor-text {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #ffffff;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .custom-cursor-follower.cursor-magnetic {
    width: 62px;
    height: 62px;
    background: rgba(255, 75, 0, 0.12);
    border-color: var(--color-orange);
    box-shadow: 0 0 20px rgba(255, 75, 0, 0.3);
  }

  .custom-cursor-follower.cursor-card-view {
    width: 76px;
    height: 76px;
    background: rgba(6, 43, 92, 0.88);
    border-color: var(--color-orange);
    box-shadow: 0 10px 30px rgba(255, 75, 0, 0.4);
    backdrop-filter: blur(4px);
  }

  .custom-cursor-follower.cursor-card-view .cursor-text {
    opacity: 1;
    transform: scale(1);
  }

  /* Hide custom cursor on touch devices */
  @media (hover: none) and (pointer: coarse) {
    .custom-cursor-dot,
    .custom-cursor-follower {
      display: none !important;
    }
  }

  .scroll-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-orange), #ff7a3d, var(--color-navy));
    width: 0%;
    z-index: 99999;
    box-shadow: 0 0 10px rgba(255, 75, 0, 0.6);
  }

  .site-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
  }
</style>

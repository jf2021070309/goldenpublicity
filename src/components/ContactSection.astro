---
// ContactSection.astro (Contacto Golden Publicity)
---

<section class="contact-section" id="contacto">
  <div class="container">
    <div class="contact-header text-center reveal-scroll">
      <span class="section-kicker">Atención Personalizada</span>
      <h2 class="section-title">
        Solicita una Cotización Inmediata<span class="dot">.</span>
      </h2>
      <p class="section-lead">
        Compártenos los detalles de tu evento, exposición o campaña BTL. Te responderemos en menos de 2 horas con opciones de talento, cotización formal y disponibilidad de fechas.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Contact Form Card -->
      <div class="contact-form-card reveal-left">
        <form id="quote-form" class="quote-form">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Nombre completo o Empresa *</label>
              <input type="text" id="name" name="name" placeholder="Ej. Juan Pérez / Empresa S.A." required />
            </div>
            <div class="form-group">
              <label for="email">Correo electrónico *</label>
              <input type="email" id="email" name="email" placeholder="contacto@empresa.com" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="phone">Teléfono / WhatsApp *</label>
              <input type="tel" id="phone" name="phone" placeholder="10 dígitos (Ej. 81 1683 7738)" required />
            </div>
            <div class="form-group">
              <label for="city">Ciudad o Sede del Evento *</label>
              <select id="city" name="city" required>
                <option value="">Selecciona una opción</option>
                <option value="monterrey">Monterrey y Área Metropolitana (NL)</option>
                <option value="san_pedro">San Pedro Garza García (NL)</option>
                <option value="cdmx">Ciudad de México (CDMX)</option>
                <option value="guadalajara">Guadalajara (Jalisco)</option>
                <option value="puebla">Puebla</option>
                <option value="queretaro">Querétaro</option>
                <option value="cancun">Cancún / Riviera Maya</option>
                <option value="otro">Otro estado de la República</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="service">Servicio requerido *</label>
            <select id="service" name="service" required>
              <option value="edecanes">Edecanes AA, AAA y Modelos de Imagen</option>
              <option value="btl">Activaciones de Marca BTL & Guerrilla Marketing</option>
              <option value="expos">Expos Comerciales y Convenciones (Cintermex / WTC)</option>
              <option value="eventos">Organización Integral de Eventos, Audio & Staff</option>
              <option value="impresos">Medios Impresos, Gran Formato y Uniformes</option>
              <option value="television">Producción Audiovisual y Activación en TV</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Detalles del proyecto o requerimiento</label>
            <textarea id="message" name="message" rows="4" placeholder="Indica fechas, horarios estimados, cantidad de talentos y objetivos de la activación..."></textarea>
          </div>

          <div class="form-actions-row">
            <button type="submit" class="btn-submit">
              <span>Enviar Cotización</span>
              <i class="fa fa-paper-plane"></i>
            </button>
            <a 
              href="https://wa.me/5218116837738?text=Hola%20Golden%20Publicity,%20deseo%20una%20cotizaci%C3%B3n%20urgente%20para%20un%20evento"
              target="_blank"
              rel="noopener"
              class="btn-wa-direct"
            >
              <i class="fa fa-whatsapp"></i> Chat Directo
            </a>
          </div>

          <div id="form-feedback" class="form-feedback"></div>
        </form>
      </div>

      <!-- Contact Info Column -->
      <div class="contact-info-col reveal-right">
        <!-- Card 1: Atención Telefónica -->
        <div class="info-card">
          <div class="info-card-icon"><i class="fa fa-phone"></i></div>
          <div class="info-card-content">
            <h4>Línea Directa & WhatsApp</h4>
            <a href="tel:8116837738" class="main-contact-link">+52 1 81 1683 7738</a>
            <p>Atención inmediata de Lunes a Sábado de 8:00 AM a 8:00 PM</p>
          </div>
        </div>

        <!-- Card 2: Correo Corporativo -->
        <div class="info-card">
          <div class="info-card-icon"><i class="fa fa-envelope-o"></i></div>
          <div class="info-card-content">
            <h4>Correo Corporativo</h4>
            <a href="mailto:contacto@goldenpublicity.com.mx" class="main-contact-link">contacto@goldenpublicity.com.mx</a>
            <p>Envíanos tus briefs, requerimientos y órdenes de cotización.</p>
          </div>
        </div>

        <!-- Card 3: Ubicación y Sede -->
        <div class="info-card">
          <div class="info-card-icon"><i class="fa fa-map-marker"></i></div>
          <div class="info-card-content">
            <h4>Sede Corporativa</h4>
            <p><strong>San Pedro Garza García:</strong> Av. Lázaro Cárdenas 2400, C.P. 66260, San Pedro Garza García, N.L., México.</p>
            <p style="margin-top: 6px;"><strong>Cobertura:</strong> Monterrey, CDMX, Guadalajara, Puebla, Querétaro y toda la República Mexicana.</p>
          </div>
        </div>

        <!-- Direct WhatsApp Box -->
        <div class="whatsapp-support-card">
          <div class="wa-content">
            <h4>¿Tienes un evento urgente?</h4>
            <p>Escríbenos directamente por WhatsApp para asignarte un coordinador de proyecto en este momento.</p>
          </div>
          <a 
            href="https://wa.me/5218116837738?text=Hola%20Golden%20Publicity,%20tengo%20un%20evento%20pronto%20y%20necesito%20cotizaci%C3%B3n" 
            target="_blank" 
            rel="noopener" 
            class="btn-wa-card"
          >
            <i class="fa fa-whatsapp"></i> Hablar con Asesor
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (feedback) {
      feedback.textContent = '¡Gracias por contactar a Golden Publicity! Tu solicitud ha sido registrada correctamente. Un coordinador se comunicará contigo de inmediato.';
      feedback.className = 'form-feedback success';
      form.reset();
    }
  });
</script>

<style>
  .contact-section {
    padding: 105px 0 95px;
    background-color: #f8fafc;
    position: relative;
  }

  .contact-header {
    margin-bottom: 55px;
  }



  .contact-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 40px;
  }

  .contact-form-card {
    background: #ffffff;
    padding: 45px 40px;
    border-radius: 20px;
    box-shadow: 0 15px 40px rgba(6, 43, 92, 0.07);
    border: 1px solid #eef2f6;
    border-top: 5px solid var(--color-orange);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.95rem;
    color: #1e293b;
    background: #f8fafc;
    transition: all 0.25s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-orange);
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(255, 75, 0, 0.12);
  }

  .form-actions-row {
    display: flex;
    gap: 16px;
    margin-top: 10px;
  }

  .btn-submit {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--color-orange);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 16px 28px;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(255, 75, 0, 0.35);
    transition: var(--transition-smooth);
    border: none;
    cursor: pointer;
  }

  .btn-submit:hover {
    background: var(--color-navy);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(6, 43, 92, 0.3);
  }

  .btn-wa-direct {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #25D366;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 16px 24px;
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
    transition: var(--transition-smooth);
  }

  .btn-wa-direct:hover {
    background: #1eb956;
    transform: translateY(-2px);
    color: #ffffff;
  }

  .form-feedback {
    margin-top: 20px;
    padding: 14px 18px;
    border-radius: 10px;
    font-size: 0.92rem;
    display: none;
  }

  .form-feedback.success {
    display: block;
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  /* Info Column */
  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .info-card {
    display: flex;
    gap: 18px;
    padding: 24px 22px;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #eef2f6;
    box-shadow: 0 8px 25px rgba(6, 43, 92, 0.04);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .info-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 75, 0, 0.3);
  }

  .info-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(255, 75, 0, 0.12), rgba(6, 43, 92, 0.08));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-orange);
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .info-card-content h4 {
    font-size: 1.1rem;
    color: var(--color-navy);
    font-weight: 700;
    margin-bottom: 4px;
  }

  .main-contact-link {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-orange);
    display: block;
    margin-bottom: 6px;
  }

  .info-card-content p {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
  }

  .whatsapp-support-card {
    background: linear-gradient(135deg, var(--color-navy) 0%, #0a3d7d 100%);
    border-radius: 18px;
    padding: 28px 24px;
    color: #ffffff;
    box-shadow: 0 12px 30px rgba(6, 43, 92, 0.2);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .wa-content h4 {
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .wa-content p {
    font-size: 0.88rem;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.5;
  }

  .btn-wa-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #25D366;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 12px 20px;
    border-radius: 999px;
    transition: var(--transition-smooth);
    align-self: flex-start;
  }

  .btn-wa-card:hover {
    background: #1eb956;
    transform: translateY(-2px);
    color: #ffffff;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .form-actions-row {
      flex-direction: column;
    }

    .btn-submit,
    .btn-wa-direct,
    .btn-wa-card {
      width: 100%;
    }

    .contact-form-card {
      padding: 30px 20px;
    }
  }
</style>

  }

  .talent-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 45px rgba(255, 75, 0, 0.16), 0 8px 20px rgba(6, 43, 92, 0.08);
    border-color: rgba(255, 75, 0, 0.3);
  }

  .card-image-box {
    position: relative;
    width: 100%;
    height: 380px;
    overflow: hidden;
    background: #062B5C;
  }

  .card-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .talent-card:hover .card-image-box img {
    transform: scale(1.07);
  }

  .card-status-pill {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(6, 43, 92, 0.75);
    backdrop-filter: blur(8px);

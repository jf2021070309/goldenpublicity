---
// ForeignCoverage.astro (Cobertura Nacional Golden Publicity)
const regions = [
  { city: "MONTERREY & SAN PEDRO", state: "Nuevo León (Sede Principal)", isHub: true },
  { city: "CIUDAD DE MÉXICO", state: "CDMX & Zona Metropolitana", isHub: true },
  { city: "GUADALAJARA", state: "Jalisco & Bajío", isHub: true },
  { city: "PUEBLA", state: "Puebla & Tlaxcala", isHub: false },
  { city: "QUERÉTARO", state: "Querétaro & San Luis Potosí", isHub: false },
  { city: "CANCÚN & RIVIERA MAYA", state: "Quintana Roo", isHub: false }
];
---

<section class="national-coverage-section" id="cobertura">
  <div class="coverage-grid">
    <!-- Left text side -->
    <div class="coverage-content-side reveal-left">
      <div class="coverage-inner-box">
        <span class="section-kicker">Alcance en Toda la República</span>
        <h2 class="coverage-title">
          Cobertura en Todo México<span class="dot">.</span>
        </h2>
        <p class="coverage-desc">
          Con sede central en <strong>San Pedro Garza García y Monterrey</strong>, contamos con una sólida red logística y talento local calificado en las principales ciudades del país. Gestionamos desde eventos simultáneos en múltiples plazas hasta el traslado y viáticos de personal especializado según la imagen requerida por tu marca.
        </p>

        <div class="coverage-hubs-grid">
          {regions.map(r => (
            <div class={`hub-item ${r.isHub ? 'hub-primary' : ''}`}>
              <div class="hub-icon-dot">
                <i class="fa fa-circle"></i>
              </div>
              <div class="hub-info">
                <h4 class="hub-city">{r.city}</h4>
                <span class="hub-state">{r.state}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="coverage-footer-cta">
          <div class="coverage-note">
            <i class="fa fa-truck"></i> 
            <span>Coordinación integral con traslado foráneo, hospedaje y viáticos para cualquier estado del país.</span>
          </div>
          <a href="#contacto" class="btn-golden-primary">
            <i class="fa fa-envelope-o"></i> Consultar Cobertura para Mi Ciudad
          </a>
        </div>
      </div>
    </div>

    <!-- Right image side -->
    <div class="coverage-image-side reveal-right">
      <div class="image-overlay-card">
        <div class="overlay-stat">
          <span class="stat-big">+32</span>
          <span class="stat-text">Estados con Capacidad Operativa</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .national-coverage-section {
    width: 100%;
    background-color: #ffffff;
    overflow: hidden;
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    min-height: 650px;
  }

  .coverage-content-side {
    padding: 90px 80px 80px;
    display: flex;
    align-items: center;
    background: #ffffff;
  }

  .coverage-inner-box {
    max-width: 620px;
  }



  .coverage-title {
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .coverage-title .dot {
    color: var(--color-orange);
  }

  .coverage-desc {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 35px;
  }

  .coverage-hubs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 35px;
  }

  .hub-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    transition: var(--transition-smooth);
  }

  .hub-item:hover {
    border-color: var(--color-orange);
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(255, 75, 0, 0.1);
    transform: translateX(4px);
  }

  .hub-primary {
    border-left: 3px solid var(--color-orange);
    background: #fff7ed;
  }

  .hub-icon-dot {
    font-size: 0.55rem;
    color: var(--color-orange);
  }

  .hub-city {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0;
  }

  .hub-state {
    font-size: 0.75rem;
    color: #64748b;
  }

  .coverage-footer-cta {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .coverage-note {
    font-size: 0.88rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .coverage-note i {
    color: var(--color-orange);
    font-size: 1.1rem;
  }

  .btn-golden-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--color-orange);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 15px 32px;
    border-radius: 999px;
    box-shadow: 0 6px 20px rgba(255, 75, 0, 0.35);
    transition: var(--transition-smooth);
    align-self: flex-start;
  }

  .btn-golden-primary:hover {
    background: var(--color-navy);
    transform: translateY(-2px);
    color: #ffffff;
  }

  /* Right image side */
  .coverage-image-side {
    position: relative;
    background-image: url('https://www.goldenpublicity.com.mx/wp-content/uploads/2024/05/fullock-activacion.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    padding: 40px;
  }

  .coverage-image-side::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 43, 92, 0.2) 0%, rgba(6, 43, 92, 0.85) 100%);
  }

  .image-overlay-card {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 24px 30px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
  }

  .overlay-stat {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stat-big {
    font-family: var(--font-heading);
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--color-orange);
    line-height: 1;
  }

  .stat-text {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.3;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .coverage-grid {
      grid-template-columns: 1fr;
    }

    .coverage-content-side {
      padding: 60px 40px;
    }

    .coverage-image-side {
      height: 380px;
    }
  }

  @media (max-width: 650px) {
    .coverage-content-side {
      padding: 50px 20px;
    }

    .coverage-title {
      font-size: 2.2rem;
    }

    .coverage-hubs-grid {
      grid-template-columns: 1fr;
    }

    .btn-golden-primary {
      width: 100%;
    }
  }
</style>

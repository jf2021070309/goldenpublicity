---
// Footer.astro (Footer Golden Publicity)
---

<footer class="footer">
  <div class="footer-top">
    <div class="container">
      <div class="footer-grid">
        <!-- Col 1: Brand & Bio -->
        <div class="footer-col brand-col">
          <a href="/" class="footer-logo">
            <img 
              src="/images/branding/logo-golden-publicity.jpg" 
              alt="Golden Publicity Logo" 
              width="210" 
              height="105" 
            />
          </a>
          <p class="footer-bio">
            Más de 10 años de liderazgo en medios publicitarios, activaciones BTL, edecanes AA/AAA, modelos y producción de eventos en Monterrey, San Pedro y toda la República Mexicana.
          </p>
          <div class="footer-socials">
            <a href="https://www.instagram.com/goldenpublicity23" target="_blank" rel="noopener" class="foot-soc" aria-label="Instagram">
              <i class="fa fa-instagram"></i>
            </a>
            <a href="https://www.facebook.com/profile.php?id=100090488202295&mibextid=ZbWKwL" target="_blank" rel="noopener" class="foot-soc" aria-label="Facebook">
              <i class="fa fa-facebook"></i>
            </a>
            <a href="https://wa.me/5218116837738" target="_blank" rel="noopener" class="foot-soc" aria-label="WhatsApp">
              <i class="fa fa-whatsapp"></i>
            </a>
          </div>
        </div>

        <!-- Col 2: Servicios -->
        <div class="footer-col">
          <h4 class="footer-col-title">Servicios</h4>
          <ul class="footer-links-list">
            <li><a href="#servicios"><i class="fa fa-angle-right"></i> Activaciones de Marca BTL</a></li>
            <li><a href="#equipo-surf"><i class="fa fa-angle-right"></i> Edecanes AA y AAA</a></li>
            <li><a href="#equipo-surf"><i class="fa fa-angle-right"></i> Modelos de Pasarela y Moda</a></li>
            <li><a href="#servicios"><i class="fa fa-angle-right"></i> Expos y Convenciones Cintermex</a></li>
            <li><a href="#servicios"><i class="fa fa-angle-right"></i> Medios Impresos y Gran Formato</a></li>
            <li><a href="#servicios"><i class="fa fa-angle-right"></i> Producción Audiovisual y TV</a></li>
          </ul>
        </div>

        <!-- Col 3: Cobertura -->
        <div class="footer-col">
          <h4 class="footer-col-title">Cobertura Nacional</h4>
          <ul class="cobertura-list">
            <li><i class="fa fa-check-circle"></i> <strong>MONTERREY & SAN PEDRO 💎</strong></li>
            <li><i class="fa fa-check-circle"></i> <strong>CIUDAD DE MÉXICO (CDMX)</strong></li>
            <li><i class="fa fa-check-circle"></i> <strong>GUADALAJARA</strong></li>
            <li><i class="fa fa-check-circle"></i> <strong>PUEBLA</strong></li>
            <li><i class="fa fa-check-circle"></i> <strong>QUERÉTARO</strong></li>
            <li><i class="fa fa-check-circle"></i> <strong>CANCÚN & RIVIERA MAYA</strong></li>
            <li class="more-states"><i class="fa fa-globe"></i> COBERTURA EN TODO MÉXICO</li>
          </ul>
        </div>

        <!-- Col 4: Contacto Corporativo -->
        <div class="footer-col">
          <h4 class="footer-col-title">Contacto Directo</h4>
          <div class="footer-contact-block">
            <p class="contact-highlight">
              <i class="fa fa-phone"></i> 
              <a href="tel:8116837738">81 1683 7738</a>
            </p>
            <p>
              <i class="fa fa-envelope-o"></i> 
              <a href="mailto:contacto@goldenpublicity.com.mx">contacto@goldenpublicity.com.mx</a>
            </p>
            <p class="address-text">
              <i class="fa fa-map-marker"></i> 
              Av. Lázaro Cárdenas 2400, San Pedro Garza García, N.L., México.
            </p>
          </div>

          <h5 class="sub-contact-title">Casting & Modelos</h5>
          <div class="footer-contact-block">
            <p><i class="fa fa-whatsapp"></i> <a href="https://wa.me/5218116837738" target="_blank" rel="noopener">Envía tu Book por WhatsApp</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Bottom / Copyright -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright-text">
        &copy; 2026 <strong>Golden Publicity</strong>. Todos los derechos reservados. Líder en medios publicitarios, BTL y modelos.
      </p>
      <div class="footer-bottom-links">
        <a href="#contacto">Contacto</a>
        <span>&bull;</span>
        <a href="#servicios">Servicios</a>
        <span>&bull;</span>
        <a href="#clientes">Clientes</a>
        <span>&bull;</span>
        <a href="#equipo-surf">Talento</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #031329;
    color: #94a3b8;
    position: relative;
    border-top: 3px solid var(--color-orange);
  }

  .footer-top {
    padding: 85px 0 65px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.1fr;
    gap: 40px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 20px;
  }

  .footer-logo img {
    max-height: 75px;
    width: auto;
    object-fit: contain;
    border-radius: 8px;
    background: #ffffff;
    padding: 6px 12px;
  }

  .footer-bio {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 25px;
  }

  .footer-socials {
    display: flex;
    gap: 12px;
  }

  .foot-soc {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.1rem;
    transition: var(--transition-smooth);
  }

  .foot-soc:hover {
    background: var(--color-orange);
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(255, 75, 0, 0.4);
  }

  .footer-col-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 24px;
    position: relative;
    padding-bottom: 12px;
    letter-spacing: 0.5px;
  }

  .footer-col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 35px;
    height: 2.5px;
    background: var(--color-orange);
    border-radius: 2px;
  }

  .footer-links-list,
  .cobertura-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links-list a {
    color: #cbd5e1;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s ease;
  }

  .footer-links-list a:hover {
    color: var(--color-orange);
    transform: translateX(4px);
  }

  .cobertura-list li {
    font-size: 0.88rem;
    color: #cbd5e1;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cobertura-list i {
    color: var(--color-orange);
    font-size: 0.85rem;
  }

  .more-states {
    font-weight: 700;
    color: var(--color-orange) !important;
    margin-top: 4px;
  }

  .footer-contact-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 22px;
  }

  .footer-contact-block p {
    font-size: 0.92rem;
    color: #cbd5e1;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
  }

  .footer-contact-block i {
    color: var(--color-orange);
    font-size: 1.05rem;
    margin-top: 3px;
  }

  .contact-highlight a {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }

  .contact-highlight a:hover {
    color: var(--color-orange);
  }

  .sub-contact-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  /* Footer Bottom */
  .footer-bottom {
    background: #020c1b;
    padding: 24px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .copyright-text {
    font-size: 0.88rem;
    color: #94a3b8;
    margin: 0;
  }

  .copyright-text strong {
    color: #ffffff;
  }

  .footer-bottom-links {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 0.85rem;
    color: #64748b;
  }

  .footer-bottom-links a {
    color: #cbd5e1;
  }

  .footer-bottom-links a:hover {
    color: var(--color-orange);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 45px;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }

    .footer-bottom-links {
      justify-content: center;
    }
  }
</style>
